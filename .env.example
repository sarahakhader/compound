# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is already in .gitignore.

# ── Contact form email delivery (Resend) ──────────────────────────────────
# Sign up at https://resend.com, create an API key, and add it here.
# Without this key the form still works but submissions are only logged to
# the server console (useful in local development).
RESEND_API_KEY=

# Email address where contact form submissions are delivered.
CONTACT_EMAIL=thecompoundlabs@gmail.com

# Sender address shown in the "from" field of delivered emails.
# Resend requires a verified domain for custom from-addresses.
# Use "onboarding@resend.dev" during testing (Resend's shared domain).
EMAIL_FROM=Compound <contact@yourdomain.com>
